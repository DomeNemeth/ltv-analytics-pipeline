*.egg-info/
build/
dist/

# Local environment overrides (see .env.example)
.env

# Source data and warehouse are build artifacts, never sources of truth.
# `ltv ingest` rebuilds them from public downloads.
data/raw/*
!data/raw/.gitkeep
*.duckdb
*.duckdb.wal

# Fitted models. Build output, rebuilt by `ltv fit`, and a netCDF of a posterior over 23,570
# customers is not something version control should be carrying.
data/models/

# dbt
dbt/target/
dbt/dbt_packages/
dbt/logs/

# Prefect
.prefect/

# Node / Evidence
node_modules/
dashboard/.evidence/
dashboard/.svelte-kit/
dashboard/build/

# PyTensor compile cache
.pytensor/

# Working roadmap. CLAUDE.md is the public status document and records what is verified;
# the roadmap records what is planned, and plans change.
docs/ROADMAP.md

