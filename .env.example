# Copy to .env only if you need to override a default. A clean clone needs none of these.
# All settings are read by src/ltv/config.py with the LTV_ prefix.

# Relocate the entire project tree (this is how the Docker image points at /app).
# LTV_REPO_ROOT=/app

# Warehouse filename inside <repo_root>/data/.
# LTV_WAREHOUSE_FILENAME=warehouse.duckdb

# Calibration/holdout split in weeks. 39/39 is the canonical Fader & Hardie CDNOW split and is what
# makes the reported error metrics comparable to published benchmarks. Change with care.
# LTV_CALIBRATION_WEEKS=39
# LTV_HOLDOUT_WEEKS=39

# LTV_RANDOM_SEED=42
